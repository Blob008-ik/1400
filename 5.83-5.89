using System;

class Program6
{
    static void Task_5_83()
    {
        Console.WriteLine("5.83 - Сумма положительных нечетных чисел меньше 50");

        int sum = 0;
        for (int i = 1; i < 50; i += 2) // начинаем с 1, шаг 2 (только нечетные)
        {
            sum += i;
        }

        Console.WriteLine($"Сумма: {sum}");
    }

    static void Task_5_84()
    {
        Console.WriteLine("\n5.84 - Сумма всех четных трехзначных чисел");

        int sum = 0;
        for (int i = 100; i <= 998; i += 2) // начинаем с 100, шаг 2 (только четные)
        {
            sum += i;
        }

        Console.WriteLine($"Сумма: {sum}");
    }

    static void Task_5_85()
    {
        Console.WriteLine("\n5.85 - Сумма чисел от a до b, кратных четырем");
        Console.Write("Введите a: ");
        int a = int.Parse(Console.ReadLine());
        Console.Write("Введите b (b > a): ");
        int b = int.Parse(Console.ReadLine());

        int sum = 0;
        Console.Write($"Числа от {a} до {b}, кратные 4: ");
        for (int i = a; i <= b; i++)
        {
            if (i % 4 == 0)
            {
                sum += i;
                Console.Write(i + " ");
            }
        }
        Console.WriteLine($"\nСумма: {sum}");
    }

static void Task_5_87()
{
    Console.WriteLine("\n5.87 - Числа 100-500, сумма цифр которых равна 15");

    int count = 0;
    Console.Write("Числа: ");
    for (int i = 100; i <= 500; i++)
    {
        int sumDigits = (i / 100) + ((i / 10) % 10) + (i % 10);
        if (sumDigits == 15)
        {
            count++;
            Console.Write(i + " ");
            if (count % 10 == 0) Console.WriteLine(); // перенос строки каждые 10 чисел
        }
    }
    Console.WriteLine($"\nВсего чисел: {count}");
}

static void Task_5_88()
{
    Console.WriteLine("\n5.88 - Трехзначные числа с заданной суммой цифр");
    Console.Write("Введите сумму цифр s (0 < s ≤ 27): ");
    int s = int.Parse(Console.ReadLine());

    int count = 0;
    Console.Write($"Трехзначные числа с суммой цифр {s}: ");
    for (int i = 100; i <= 999; i++)
    {
        int sumDigits = (i / 100) + ((i / 10) % 10) + (i % 10);
        if (sumDigits == s)
        {
            count++;
            Console.Write(i + " ");
            if (count % 10 == 0) Console.WriteLine();
        }
    }
    Console.WriteLine($"\nВсего чисел: {count}");
}

static void Task_5_89()
{
    Console.WriteLine("\n5.89 - Трехзначные числа, кратные 7 и сумма цифр кратна 7");

    int count = 0;
    Console.Write("Числа: ");
    for (int i = 100; i <= 999; i++)
    {
        if (i % 7 == 0)
        {
            int sumDigits = (i / 100) + ((i / 10) % 10) + (i % 10);
            if (sumDigits % 7 == 0)
            {
                count++;
                Console.Write(i + " ");
                if (count % 10 == 0) Console.WriteLine();
            }
        }
    }
    Console.WriteLine($"\nВсего чисел: {count}");
}

static void Main()
{
    Console.WriteLine("Решение задач 5.83-5.89");
    Console.WriteLine("======================");

    Task_5_83();
    Task_5_84();
    Task_5_85();
    Task_5_87();
    Task_5_88();
    Task_5_89();

    Console.WriteLine("\nНажмите любую клавишу для выхода...");
    Console.ReadKey();
}
}