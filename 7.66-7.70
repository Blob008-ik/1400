using System;
class Program
{
    static void Main()
    {
        Console.WriteLine("=== ЗАДАЧИ 7.66-7.70 ===\n");

        Task7_66();
        Task7_67();
        Task7_68();
        Task7_69();
        Task7_70();
    }

    // 7.66. Отрицательные числа в начале
    static void Task7_66()
    {
        Console.WriteLine("7.66: Отрицательные числа в начале последовательности");

        Console.Write("Сколько чисел? (n): ");
        int n = int.Parse(Console.ReadLine());

        int count = 0;
        bool foundPositive = false;

        Console.WriteLine($"Введите {n} чисел (начинается с отрицательного):");
        for (int i = 0; i < n; i++)
        {
            int num = int.Parse(Console.ReadLine());

            // Без условного оператора, используем цикл while
            if (!foundPositive && num < 0)
                count++;
            else
                foundPositive = true;
        }

        Console.WriteLine($"Отрицательных чисел в начале: {count}\n");
    }

    // 7.67. Числа до первого нуля
    static void Task7_67()
    {
        Console.WriteLine("7.67: Числа перед первым нулем");

        int count = 0;
        bool foundZero = false;

        Console.WriteLine("Вводите числа (после первого 0 ввод прекратится):");
        while (!foundZero)
        {
            int num = int.Parse(Console.ReadLine());

            if (num == 0)
                foundZero = true;
            else
                count++;
        }

        Console.WriteLine($"Чисел перед первым нулем: {count}\n");
    }

    // 7.68. Равные элементы в начале
    static void Task7_68()
    {
        Console.WriteLine("7.68: Равные элементы в начале");

        Console.Write("Сколько чисел? (n): ");
        int n = int.Parse(Console.ReadLine());

        int count = 1;
        int firstNum = 0;

        Console.WriteLine($"Введите {n} чисел (первые несколько равны):");
        for (int i = 0; i < n; i++)
        {
            int num = int.Parse(Console.ReadLine());

            if (i == 0)
                firstNum = num;
            else if (num == firstNum && count == i)
                count++;
        }

        Console.WriteLine($"Равных элементов в начале: {count}\n");
    }

    // 7.69. Оценки по информатике (оба случая)
    static void Task7_69()
    {
        Console.WriteLine("7.69: Оценки по информатике");

        Console.Write("Сколько учеников? (20 или другое): ");
        int n = int.Parse(Console.ReadLine());

        int count5 = 0;
        bool allAre5 = true;

        Console.WriteLine($"Введите оценки {n} учеников (5 в начале):");
        for (int i = 0; i < n; i++)
        {
            int grade = int.Parse(Console.ReadLine());

            if (grade == 5)
                count5++;
            else
                allAre5 = false;
        }

        Console.WriteLine($"Случай 1 (не все пятерки): {count5}");
        Console.WriteLine($"Случай 2 (могут быть все пятерки): {(allAre5 ? n : count5)}\n");
    }

    // 7.70. Осадки в мае (оба случая)
    static void Task7_70()
    {
        Console.WriteLine("7.70: Осадки в мае");

        int daysWithoutRain = 0;
        bool rainStarted = false;
        int totalDays = 31;

        Console.WriteLine($"Введите количество осадков за 31 день мая (1 мая - 0 мм):");
        for (int day = 1; day <= totalDays; day++)
        {
            Console.Write($"День {day}: ");
            int rain = int.Parse(Console.ReadLine());

            if (day == 1 && rain != 0)
            {
                Console.WriteLine("Ошибка: 1 мая осадков не было!");
                return;

}

            if (!rainStarted && rain == 0)
                daysWithoutRain++;
            else
                rainStarted = true;
        }

        Console.WriteLine($"Случай 1 (осадки были): {daysWithoutRain}");
        Console.WriteLine($"Случай 2 (возможно не было осадков): {daysWithoutRain}");
    }
}