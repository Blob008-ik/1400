using System;


class Program9
{
    static void Task_7_41()
    {
        Console.WriteLine("7.41 - Сумма чисел > p из n вещественных чисел");
        Console.Write("Введите количество чисел n: ");
        int n = int.Parse(Console.ReadLine());
        Console.Write("Введите p для сравнения: ");
        double p = double.Parse(Console.ReadLine());

        double[] numbers = new double[n];
        double sumGreater = 0;
        int countGreater = 0;

        Console.WriteLine($"Введите {n} вещественных чисел:");
        for (int i = 0; i < n; i++)
        {
            Console.Write($"b{i + 1}: ");
            numbers[i] = double.Parse(Console.ReadLine());

            if (numbers[i] > p)
            {
                sumGreater += numbers[i];
                countGreater++;
            }
        }

        Console.WriteLine($"\nЧисел больше {p}: {countGreater}");
        Console.WriteLine($"Их сумма: {sumGreater:F2}");
    }

    static void Task_7_42()
    {
        Console.WriteLine("\n7.42 - Сумма четных чисел из 10 целых");

        int[] numbers = new int[10];
        int sumEven = 0;

        Console.WriteLine("Введите 10 целых чисел:");
        for (int i = 0; i < 10; i++)
        {
            Console.Write($"d{i + 1}: ");
            numbers[i] = int.Parse(Console.ReadLine());

            if (numbers[i] % 2 == 0)
            {
                sumEven += numbers[i];
            }
        }

        Console.WriteLine($"\nСумма четных чисел: {sumEven}");

        Console.Write("Четные числа: ");
        for (int i = 0; i < 10; i++)
        {
            if (numbers[i] % 2 == 0)
            {
                Console.Write($"{numbers[i]} ");
            }
        }
        Console.WriteLine();
    }

    static void Task_7_43()
    {
        Console.WriteLine("\n7.43 - Сумма чисел, оканчивающихся на 0, из 10 целых");

        int[] numbers = new int[10];
        int sumEndsWithZero = 0;

        Console.WriteLine("Введите 10 целых чисел:");
        for (int i = 0; i < 10; i++)
        {
            Console.Write($"Число {i + 1}: ");
            numbers[i] = int.Parse(Console.ReadLine());

            if (numbers[i] % 10 == 0)
            {
                sumEndsWithZero += numbers[i];
            }
        }

        Console.WriteLine($"\nСумма чисел, оканчивающихся на 0: {sumEndsWithZero}");

        Console.Write("Числа, оканчивающиеся на 0: ");
        for (int i = 0; i < 10; i++)
        {
            if (numbers[i] % 10 == 0)
            {
                Console.Write($"{numbers[i]} ");
            }
        }
        Console.WriteLine();
    }

    static void Task_7_44()
    {
        Console.WriteLine("\n7.44 - Сумма a2 + a4 + a6 + ... из 20 целых чисел");

        int[] numbers = new int[20];
        int sumEvenIndices = 0;

        Console.WriteLine("Введите 20 целых чисел:");
        for (int i = 0; i < 20; i++)
        {
            Console.Write($"a{i + 1}: ");
            numbers[i] = int.Parse(Console.ReadLine());

            // Индексы 1, 3, 5... в массиве это элементы 0, 2, 4...
            // Нам нужны элементы с четными индексами (1, 3, 5... позиции)
            // Это индексы 0, 2, 4... в массиве
            if (i % 2 == 0) // четный индекс в массиве = нечетная позиция (a2, a4...)
            {
                sumEvenIndices += numbers[i];
            }
        }

        Console.WriteLine($"\nСумма a2 + a4 + a6 + ...: {sumEvenIndices}");

        Console.Write("Слагаемые: ");
        for (int i = 0; i < 20; i += 2)
        {
            Console.Write($"a{i + 2}={numbers[i]} ");
        }
        Console.WriteLine();
    }

    static void Task_7_45()

{
        Console.WriteLine("\n7.45 - Сумма -c1 - c3 - c5 - ... из 15 вещественных чисел");
        
        double[] numbers = new double[15];
    double sumOddIndices = 0;

    Console.WriteLine("Введите 15 вещественных чисел:");
        for (int i = 0; i< 15; i++)
        {
            Console.Write($"c{i+1}: ");
            numbers[i] = double.Parse(Console.ReadLine());
            
            // Нечетные индексы в массиве (0, 2, 4...) = нечетные позиции (c1, c3, c5...)
            if (i % 2 == 0) // четный индекс = нечетная позиция
            {
                sumOddIndices -= numbers[i]; // отрицательная сумма
            }
        }
        
        Console.WriteLine($"\nСумма -c1 - c3 - c5 - ...: {sumOddIndices:F2}");

Console.Write("Слагаемые: ");
for (int i = 0; i < 15; i += 2)
{
    Console.Write($"-c{i + 1}({-numbers[i]}) ");
}
Console.WriteLine();
    }
    
    static void Main()
{
    Console.WriteLine("Решение задач 7.41-7.45");
    Console.WriteLine("======================");

    Task_7_41();
    Task_7_42();
    Task_7_43();
    Task_7_44();
    Task_7_45();

    Console.WriteLine("\nНажмите любую клавишу для выхода...");
    Console.ReadKey();
}
}