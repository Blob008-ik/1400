using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== ЗАДАЧИ 7.81-7.85 ===\n");

        Task7_81();
        Task7_82();
        Task7_83();
        Task7_84();
        Task7_85();
    }

    // 7.81. Футбол (одно число на игру)
    static void Task7_81()
    {
        Console.WriteLine("7.81: Футбол (одно число на игру)");

        const int games = 20;
        int wins = 0, draws = 0, losses = 0;
        int totalPoints = 0;

        Console.WriteLine($"Введите {games} чисел (32=3:2, 22=2:2, 0=0:0):");
        for (int i = 1; i <= games; i++)
        {
            Console.Write($"Игра {i}: ");
            int number = int.Parse(Console.ReadLine());

            // Извлекаем цифры
            int scored, conceded;
            if (number < 10)
            {
                scored = number / 10;
                conceded = number % 10;
            }
            else
            {
                scored = number / 10;
                conceded = number % 10;
            }

            // Определяем результат
            if (scored > conceded)
            {
                wins++;
                totalPoints += 3;
            }
            else if (scored == conceded)
            {
                draws++;
                totalPoints += 1;
            }
            else
            {
                losses++;
            }
        }

        Console.WriteLine($"Выигрышей: {wins}");
        Console.WriteLine($"Ничьих: {draws}");
        Console.WriteLine($"Проигрышей: {losses}");
        Console.WriteLine($"Очков: {totalPoints}\n");
    }

    // 7.82. Пары соседних чисел
    static void Task7_82()
    {
        Console.WriteLine("7.82: Пары соседних чисел");

        Console.Write("Сколько чисел? (n): ");
        int n = int.Parse(Console.ReadLine());

        int[] numbers = new int[n];
        int equalPairs = 0, zeroPairs = 0, evenPairs = 0, end5Pairs = 0;

        Console.WriteLine($"Введите {n} чисел:");
        for (int i = 0; i < n; i++)
        {
            numbers[i] = int.Parse(Console.ReadLine());
        }

        // Проверяем пары
        for (int i = 0; i < n - 1; i++)
        {
            if (numbers[i] == numbers[i + 1]) equalPairs++;
            if (numbers[i] == 0 && numbers[i + 1] == 0) zeroPairs++;
            if (numbers[i] % 2 == 0 && numbers[i + 1] % 2 == 0) evenPairs++;
            if (numbers[i] % 10 == 5 && numbers[i + 1] % 10 == 5) end5Pairs++;
        }

        Console.WriteLine($"а) Равных пар: {equalPairs}");
        Console.WriteLine($"б) Пар нулей: {zeroPairs}");
        Console.WriteLine($"в) Четных пар: {evenPairs}");
        Console.WriteLine($"г) Пар, оканчивающихся на 5: {end5Pairs}\n");
    }

    // 7.83. Есть ли четное число
    static void Task7_83()
    {
        Console.WriteLine("7.83: Есть ли четное число");

        Console.Write("Сколько чисел? ");
        int n = int.Parse(Console.ReadLine());

        bool hasEven = false;

        Console.WriteLine($"Введите {n} чисел:");
        for (int i = 0; i < n; i++)
        {
            int num = int.Parse(Console.ReadLine());
            if (num % 2 == 0) hasEven = true;
        }

        Console.WriteLine($"Четное число {(hasEven ? "есть" : "отсутствует")}\n");
    }

    // 7.84. Положительных не больше 5
    static void Task7_84()
    {
        Console.WriteLine("7.84: Положительных не больше 5");

        const int count = 10;
        int positiveCount = 0;

        Console.WriteLine($"Введите {count} целых чисел:");
        for (int i = 0; i < count; i++)
        {
            int num = int.Parse(Console.ReadLine());
            if (num > 0) positiveCount++;

}

        bool isCorrect = positiveCount <= 5;
        Console.WriteLine($"Положительных чисел: {positiveCount}");
        Console.WriteLine($"Утверждение {(isCorrect ? "верно" : "неверно")}\n");
    }

    // 7.85. Числа не больше 33.2, кратные 4
    static void Task7_85()
    {
        Console.WriteLine("7.85: Числа ≤33.2, кратные 4");

        const int count = 15;
        int smallNumbers = 0;

        Console.WriteLine($"Введите {count} вещественных чисел:");
        for (int i = 0; i < count; i++)
        {
            double num = double.Parse(Console.ReadLine());
            if (num <= 33.2) smallNumbers++;
        }

        bool isCorrect = smallNumbers % 4 == 0;
        Console.WriteLine($"Чисел ≤33.2: {smallNumbers}");
        Console.WriteLine($"Кратно 4: {(isCorrect ? "да" : "нет")}");
    }
}