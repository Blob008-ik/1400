using System;

class Program7
{
    static void Task_5_32()
    {
        Console.WriteLine("5.32 - Сумма 1 + 1/2 + 1/3 + ... + 1/100");
        double sum = 0;
        for (int i = 1; i <= 100; i++)
        {
            sum += 1.0 / i;
        }
        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Task_5_33()
    {
        Console.WriteLine("\n5.33 - Сумма 1/(1×2) + 1/(2×3) + ... + 1/(99×100)");
        double sum = 0;
        for (int i = 1; i <= 99; i++)
        {
            sum += 1.0 / (i * (i + 1));
        }
        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Task_5_34()
    {
        Console.WriteLine("\n5.34 - Сумма квадратов 1² + 2² + ... + n²");
        Console.Write("Введите n: ");
        int n = int.Parse(Console.ReadLine());

        long sum = 0;
        for (int i = 1; i <= n; i++)
        {
            sum += i * i;
        }

        Console.WriteLine($"Сумма квадратов от 1 до {n}: {sum}");
    }

    static void Task_5_35()
    {
        Console.WriteLine("\n5.35 - Сумма 1×2 + 2×3 + ... + (n-1)×n");
        Console.Write("Введите n (n ≥ 2): ");
        int n = int.Parse(Console.ReadLine());

        long sum = 0;
        for (int i = 1; i < n; i++)
        {
            sum += i * (i + 1);
        }

        Console.WriteLine($"Сумма: {sum}");
    }

    static void Task_5_36()
    {
        Console.WriteLine("\n5.36 - Сумма x + x² + x³ + ... + x^n (без степени)");
        Console.Write("Введите x: ");
        double x = double.Parse(Console.ReadLine());
        Console.Write("Введите n: ");
        int n = int.Parse(Console.ReadLine());

        double sum = 0;
        double power = x; // начинаем с x^1
        for (int i = 1; i <= n; i++)
        {
            sum += power;
            power *= x; // умножаем на x для получения следующей степени
        }

        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Main()
    {
        Console.WriteLine("Решение задач 5.32-5.36");
        Console.WriteLine("======================");

        Task_5_32();
        Task_5_33();
        Task_5_34();
        Task_5_35();
        Task_5_36();

        Console.WriteLine("\nНажмите любую клавишу для выхода...");
        Console.ReadKey();
    }
}