using System;

class Program2
{
    static void Task_4_129()
    {
        Console.WriteLine("4.129 - Сумма двух наибольших из трех чисел");
        Console.Write("Введите первое число: ");
        double a = double.Parse(Console.ReadLine());
        Console.Write("Введите второе число: ");
        double b = double.Parse(Console.ReadLine());
        Console.Write("Введите третье число: ");
        double c = double.Parse(Console.ReadLine());

        // Находим наименьшее число
        double min = a;
        if (b < min) min = b;
        if (c < min) min = c;

        // Сумма всех трех минус наименьшее = сумма двух наибольших
        double sum = a + b + c - min;

        Console.WriteLine($"Сумма двух наибольших чисел: {sum}");
    }

    static void Task_4_130()
    {
        Console.WriteLine("\n4.130 - Произведение двух наименьших из трех чисел");
        Console.Write("Введите первое число: ");
        double a = double.Parse(Console.ReadLine());
        Console.Write("Введите второе число: ");
        double b = double.Parse(Console.ReadLine());
        Console.Write("Введите третье число: ");
        double c = double.Parse(Console.ReadLine());

        // Находим наибольшее число
        double max = a;
        if (b > max) max = b;
        if (c > max) max = c;

        // Произведение всех трех деленное на наибольшее = произведение двух наименьших
        double product = (a * b * c) / max;

        Console.WriteLine($"Произведение двух наименьших чисел: {product}");
    }

    static void Task_4_131()
    {
        Console.WriteLine("\n4.131 - Среднее арифметическое средних чисел двух троек");

        Console.WriteLine("Первая тройка чисел:");
        Console.Write("Введите a1: ");
        double a1 = double.Parse(Console.ReadLine());
        Console.Write("Введите b1: ");
        double b1 = double.Parse(Console.ReadLine());
        Console.Write("Введите c1: ");
        double c1 = double.Parse(Console.ReadLine());

        Console.WriteLine("\nВторая тройка чисел:");
        Console.Write("Введите a2: ");
        double a2 = double.Parse(Console.ReadLine());
        Console.Write("Введите b2: ");
        double b2 = double.Parse(Console.ReadLine());
        Console.Write("Введите c2: ");
        double c2 = double.Parse(Console.ReadLine());

        // Функция для нахождения среднего числа в тройке
        double FindMiddle(double x, double y, double z)
        {
            double max = x;
            if (y > max) max = y;
            if (z > max) max = z;

            double min = x;
            if (y < min) min = y;
            if (z < min) min = z;

            // Среднее = сумма всех минус максимум минус минимум
            return x + y + z - max - min;
        }

        double middle1 = FindMiddle(a1, b1, c1);
        double middle2 = FindMiddle(a2, b2, c2);
        double average = (middle1 + middle2) / 2;

        Console.WriteLine($"Среднее число первой тройки: {middle1}");
        Console.WriteLine($"Среднее число второй тройки: {middle2}");
        Console.WriteLine($"Среднее арифметическое: {average}");
    }

    static void Task_4_132()
    {
        Console.WriteLine("\n4.132 - Номер четверти координатной плоскости");
        Console.Write("Введите координату x (не ноль): ");
        double x = double.Parse(Console.ReadLine());
        Console.Write("Введите координату y (не ноль): ");
        double y = double.Parse(Console.ReadLine());

        if (x == 0 || y == 0)
        {
            Console.WriteLine("Координаты не должны быть равны нулю!");
            return;
        }

        int quarter;
        if (x > 0 && y > 0)
            quarter = 1;
        else if (x < 0 && y > 0)

quarter = 2;
        else if (x < 0 && y < 0)
            quarter = 3;
        else // x > 0 && y < 0
            quarter = 4;

        Console.WriteLine($"Точка находится в {quarter}-й четверти");
    }

    static void Main()
    {
        Console.WriteLine("Решение задач 4.129-4.132");
        Console.WriteLine("========================");

        Task_4_129();
        Task_4_130();
        Task_4_131();
        Task_4_132();

        Console.WriteLine("\nНажмите любую клавишу для выхода...");
        Console.ReadKey();
    }
}