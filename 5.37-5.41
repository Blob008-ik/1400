using System;

class Program8
{
    static void Task_5_37()
    {
        Console.WriteLine("5.37 - Сумма 1 - 1/2 + 1/3 - 1/4 + ... ± 1/n");
        Console.Write("Введите n: ");
        int n = int.Parse(Console.ReadLine());

        double sum = 0;
        int sign = 1; // начинаем с +1
        for (int i = 1; i <= n; i++)
        {
            sum += sign * (1.0 / i);
            sign = -sign; // меняем знак
        }

        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Task_5_38()
    {
        Console.WriteLine("\n5.38 - Сумма 1/1! + 1/2! + 1/3! + ... + 1/n! при x=2");
        Console.Write("Введите n: ");
        int n = int.Parse(Console.ReadLine());
        int x = 2;

        double sum = 0;
        double factorial = 1;
        double power = 1; // x^0 = 1

        for (int i = 1; i <= n; i++)
        {
            factorial *= i; // i!
            power *= x;     // x^i
            sum += power / factorial;
        }

        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Task_5_39()
    {
        Console.WriteLine("\n5.39 - Сумма x/1! - x³/3! + x⁵/5! - ... при x=2");
        Console.Write("Введите количество слагаемых: ");
        int n = int.Parse(Console.ReadLine());
        double x = 2;

        double sum = 0;
        double factorial = 1;
        double power = x; // начинаем с x^1
        int sign = 1;
        int exponent = 1;

        for (int i = 1; i <= n; i++)
        {
            // Вычисляем факториал для текущего нечетного числа
            factorial = 1;
            for (int j = 1; j <= exponent; j++)
            {
                factorial *= j;
            }

            sum += sign * power / factorial;

            // Подготовка к следующему слагаемому
            sign = -sign; // меняем знак
            exponent += 2; // следующее нечетное число
            power *= x * x; // умножаем на x² для увеличения степени
        }

        Console.WriteLine($"Сумма: {sum:F4}");
    }

    static void Task_5_40()
    {
        Console.WriteLine("\n5.40 - Сумма цифр 9-значного числа");
        Console.Write("Введите 9-значное число: ");
        long number = long.Parse(Console.ReadLine());

        int sum = 0;
        long temp = number;

        while (temp > 0)
        {
            sum += (int)(temp % 10); // получаем последнюю цифру
            temp /= 10; // удаляем последнюю цифру
        }

        Console.WriteLine($"Сумма цифр числа {number}: {sum}");
    }

    static void Task_5_41()
    {
        Console.WriteLine("\n5.41 - Произведение и сумма n последних цифр числа");
        Console.Write("Введите натуральное число: ");
        long number = long.Parse(Console.ReadLine());
        Console.Write("Введите n (не больше количества цифр): ");
        int n = int.Parse(Console.ReadLine());

        long product = 1;
        int sum = 0;
        long temp = number;
        int digitsProcessed = 0;

        while (temp > 0 && digitsProcessed < n)
        {
            int digit = (int)(temp % 10);
            product *= digit;
            sum += digit;
            temp /= 10;
            digitsProcessed++;
        }

        Console.WriteLine($"Произведение {n} последних цифр: {product}");
        Console.WriteLine($"Сумма {n} последних цифр: {sum}");
    }

    static void Main()
    {
        Console.WriteLine("Решение задач 5.37-5.41");
        Console.WriteLine("======================");

        Task_5_37();
        Task_5_38();
        Task_5_39();
        Task_5_40();
        Task_5_41();

        Console.WriteLine("\nНажмите любую клавишу для выхода...");
        Console.ReadKey();
    }
}