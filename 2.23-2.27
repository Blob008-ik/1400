using System;


class Program
{
    // 2.23. Прямоугольник: периметр и диагональ
    static void Task2_23()
    {
        Console.WriteLine("\n=== 2.23. Прямоугольник: периметр и диагональ ===");
        Console.Write("Введите длину прямоугольника: ");
        double a = double.Parse(Console.ReadLine());
        Console.Write("Введите ширину прямоугольника: ");
        double b = double.Parse(Console.ReadLine());

        double perimeter = 2 * (a + b);
        double diagonal = Math.Sqrt(a * a + b * b);

        Console.WriteLine($"Периметр: {perimeter:F2}");
        Console.WriteLine($"Длина диагонали: {diagonal:F2}");
    }

    // 2.24. Арифметические операции с двумя числами
    static void Task2_24()
    {
        Console.WriteLine("\n=== 2.24. Арифметические операции с двумя числами ===");
        Console.Write("Введите первое число: ");
        double num1 = double.Parse(Console.ReadLine());
        Console.Write("Введите второе число: ");
        double num2 = double.Parse(Console.ReadLine());

        Console.WriteLine($"Сумма: {num1 + num2}");
        Console.WriteLine($"Разность: {num1 - num2}");
        Console.WriteLine($"Произведение: {num1 * num2}");

        if (num2 != 0)
            Console.WriteLine($"Частное: {num1 / num2:F6}");
        else
            Console.WriteLine("Частное: деление на ноль невозможно!");
    }

    // 2.25. Прямоугольный параллелепипед
    static void Task2_25()
    {
        Console.WriteLine("\n=== 2.25. Прямоугольный параллелепипед ===");
        Console.Write("Введите длину: ");
        double length = double.Parse(Console.ReadLine());
        Console.Write("Введите ширину: ");
        double width = double.Parse(Console.ReadLine());
        Console.Write("Введите высоту: ");
        double height = double.Parse(Console.ReadLine());

        double volume = length * width * height;
        double lateralSurface = 2 * height * (length + width);

        Console.WriteLine($"Объем: {volume:F2}");
        Console.WriteLine($"Площадь боковой поверхности: {lateralSurface:F2}");
    }

    // 2.26. Расстояние между двумя точками
    static void Task2_26()
    {
        Console.WriteLine("\n=== 2.26. Расстояние между двумя точками ===");
        Console.Write("Введите x1: ");
        double x1 = double.Parse(Console.ReadLine());
        Console.Write("Введите y1: ");
        double y1 = double.Parse(Console.ReadLine());
        Console.Write("Введите x2: ");
        double x2 = double.Parse(Console.ReadLine());
        Console.Write("Введите y2: ");
        double y2 = double.Parse(Console.ReadLine());

        double distance = Math.Sqrt(Math.Pow(x2 - x1, 2) + Math.Pow(y2 - y1, 2));
        Console.WriteLine($"Расстояние между точками: {distance:F2}");
    }

    // 2.27. Периметр равнобедренной трапеции
    static void Task2_27()
    {
        Console.WriteLine("\n=== 2.27. Периметр равнобедренной трапеции ===");
        Console.Write("Введите большее основание: ");
        double a = double.Parse(Console.ReadLine());
        Console.Write("Введите меньшее основание: ");
        double b = double.Parse(Console.ReadLine());
        Console.Write("Введите высоту: ");
        double h = double.Parse(Console.ReadLine());

        double leg = Math.Sqrt(Math.Pow((a - b) / 2, 2) + h * h);
        double perimeter = a + b + 2 * leg;

        Console.WriteLine($"Периметр трапеции: {perimeter:F2}");
    }
}
    