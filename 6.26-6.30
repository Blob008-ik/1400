using System;

class Program6
{
    static void Task_6_26()
    {
        Console.WriteLine("6.26 - Числа, кратные 13, меньше 100");

        Console.WriteLine("а) Без цикла с условием (for):");
        for (int i = 13; i < 100; i += 13)
        {
            Console.Write(i + " ");
        }

        Console.WriteLine("\n\nб) С циклом с условием (while):");
        int j = 13;
        while (j < 100)
        {
            Console.Write(j + " ");
            j += 13;
        }
        Console.WriteLine();
    }

    static void Task_6_27()
    {
        Console.WriteLine("\n6.27 - 15 первых чисел, кратных 19, начиная с 100");

        int count = 0;
        int number = 100;

        Console.WriteLine("Первые 15 чисел, кратных 19, начиная с 100:");
        while (count < 15)
        {
            if (number % 19 == 0)
            {
                Console.Write(number + " ");
                count++;
            }
            number++;
        }
        Console.WriteLine();
    }

    static void Task_6_28()
    {
        Console.WriteLine("\n6.28 - 20 первых чисел, кратных 13 или 17, начиная с 500");

        int count = 0;
        int number = 500;

        Console.WriteLine("Первые 20 чисел, кратных 13 или 17, начиная с 500:");
        while (count < 20)
        {
            if (number % 13 == 0 || number % 17 == 0)
            {
                Console.Write(number + " ");
                count++;
            }
            number++;
        }
        Console.WriteLine();
    }

    static void Task_6_29()
    {
        Console.WriteLine("\n6.29 - 10 первых чисел, оканчивающихся на 7, кратных 9, начиная с 100");

        int count = 0;
        int number = 100;

        Console.WriteLine("Первые 10 чисел, оканчивающихся на 7, кратных 9, начиная с 100:");
        while (count < 10)
        {
            if (number % 10 == 7 && number % 9 == 0)
            {
                Console.Write(number + " ");
                count++;
            }
            number++;
        }
        Console.WriteLine();
    }

    static void Task_6_30()
    {
        Console.WriteLine("\n6.30 - Целочисленное деление и остаток (любые a и b)");
        Console.Write("Введите a: ");
        int a = int.Parse(Console.ReadLine());
        Console.Write("Введите b: ");
        int b = int.Parse(Console.ReadLine());

        if (a == 0)
        {
            Console.WriteLine("Ошибка: деление на ноль!");
            return;
        }

        // а) Целочисленное деление b на a
        int quotient = 0;
        int temp = Math.Abs(b);
        int absA = Math.Abs(a);

        while (temp >= absA)
        {
            temp -= absA;
            quotient++;
        }

        // Учитываем знаки
        if ((a < 0 && b > 0) || (a > 0 && b < 0))
        {
            quotient = -quotient;
        }

        // б) Остаток от деления
        int remainder = Math.Abs(b);
        while (remainder >= absA)
        {
            remainder -= absA;
        }

        // Остаток всегда того же знака, что и делимое (b)
        if (b < 0)
        {
            remainder = -remainder;
        }

        Console.WriteLine($"а) {b} // {a} = {quotient}");
        Console.WriteLine($"б) {b} % {a} = {remainder}");
        Console.WriteLine($"Проверка: {quotient} * {a} + {remainder} = {quotient * a + remainder}");
    }

    static void Main()
    {
        Console.WriteLine("Решение задач 6.26-6.30");
        Console.WriteLine("======================");

        Task_6_26();
        Task_6_27();
        Task_6_28();
        Task_6_29();
        Task_6_30();

        Console.WriteLine("\nНажмите любую клавишу для выхода...");
        Console.ReadKey();
    }
}